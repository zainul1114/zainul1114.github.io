<!-- JavaScript to handle silent form submission -->
<script>
  const form = document.getElementById("azileContactForm");
  const submitBtn = document.getElementById("contactSubmit");
  const successMsg = document.getElementById("formSuccess");
  const errorMsg = document.getElementById("formError");

  // The Google Apps Script URL
  const scriptURL = 'https://script.google.com/macros/s/AKfycbxScp0Y2X3Pxitx2ucFSxzb8qFzzBfD0bAVlDl20WkQEvkIHmvh81Z-heNDVbjosyw/exec';
          
  form.addEventListener("submit", function(event) {
    event.preventDefault(); 
    
    // Update button text and disable it during submission to prevent double-clicks
    submitBtn.textContent = "Sending...";
    submitBtn.disabled = true;
    
    // Hide any previous messages
    successMsg.hidden = true;
    errorMsg.hidden = true;

    fetch(scriptURL, { 
      method: 'POST', 
      mode: 'no-cors', // Add this exact line to bypass CORS errors 
      body: new FormData(form) 
    })
    .then(response => {
      // Show success message and clear form fields
      successMsg.hidden = false;
      form.reset();
      
      // Reset button state
      submitBtn.textContent = "Send";
      submitBtn.disabled = false;
      
      // Automatically hide the success message after 5 seconds
      setTimeout(() => {
        successMsg.hidden = true;
      }, 5000);
    })
    .catch(error => {
      console.error('Error!', error.message);
      
      // Show error message and reset button state
      errorMsg.hidden = false;
      submitBtn.textContent = "Send";
      submitBtn.disabled = false;
    });
  });
</script>
